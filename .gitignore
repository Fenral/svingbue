.vercel

# Local provider credentials and raw Academy voice-production work. Neither may
# be committed; accepted, processed audio lives under assets/audio/ instead.
.env.local
.voice-production/

# --- Native packaging (Capacitor) ---
# Node dependencies for the Capacitor scaffold (package.json at repo root).
node_modules/

# The iOS platform project itself is generated fresh on Codemagic's Mac
# (`npx cap add ios`) — it cannot be produced on this Windows dev machine
# (needs Xcode/CocoaPods), so the entire generated root is ignored. This also
# prevents a future local `cap add ios` from accidentally being committed.
ios/

# The Android platform project is generated FRESH in CI on every run
# (.github/workflows/android-debug.yml → `npx cap add android`) — it is
# never committed, mirroring the ios/ approach above. It may exist locally
# only as a temporary artifact of verifying scripts/android-landscape.mjs.
android/

# Assembled web bundle consumed by Capacitor — regenerated by
# `npm run copy-web`, never hand-edited, never committed.
www/

# macOS cruft (harmless on Windows, kept for when this is opened on a Mac)
.DS_Store

# Build outputs
build/
outputs/flightglass-gates/
# Completed moderated-study records and attestations are release evidence, not
# source-candidate contents.
outputs/release-evidence/onboarding/
# Completed physical-device records, media and SHA-256 attestations are release
# evidence, never source-candidate contents. The explicit rule documents that
# boundary even though the broader outputs/ rule below also covers it.
outputs/release-evidence/phone/
# Exact Vercel preview observations and immutable SHA-256 attestations are
# generated after the candidate commit exists; they remain external evidence.
outputs/release-evidence/vercel-preview/
# ...but the vendored Three.js build is a dependency that must travel with the
# repo (the native WKWebView has no CDN and loads it by relative path). The
# generic build/ rule above was silently swallowing it, which left Geometry 3D
# blank on every fresh checkout.
!vendor/three/build/
!vendor/three/build/**
*.ipa
*.app.dSYM
*.dSYM.zip

# Local backups tool sometimes creates
.sa-backups/

# Store-upload screenshots — large, regeneratable outputs of
# `npm run shots` (scripts/store-screenshots.mjs). Kept OUT of git so they
# never bloat CI checkouts; regenerate locally before each store upload.
store-assets/

# Regeneratable Academy analysis bundle: full-size captures, the all-source
# text snapshot and the self-contained HTML report. Curated contact sheets live
# under docs/academy-analysis/screenshots/ and are intentionally tracked.
outputs/academy-analysis/

# Local git worktrees (isolated agent workspaces)
.worktrees/

# Agent-artefakter og skann-output. Genereres av workflow-agenter, aldri kilde.
outputs/
